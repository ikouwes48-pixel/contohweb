<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>ArcticCool — Jasa Cuci AC Medan</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
:root{
  --b1:#0ea5e9;--b2:#0284c7;--b3:#0369a1;--b4:#075985;
  --ice:#f0f9ff;--sky:#e0f2fe;--sky2:#bae6fd;
  --teal:#0d9488;--mint:#ccfbf1;
  --amber:#f59e0b;--rose:#f43f5e;--green:#10b981;
  --text:#0c1a2e;--sub:#4a6380;--muted:#94a3b8;
  --border:#dde8f0;--card:#ffffff;--bg:#f0f6fc;
}
html,body{height:100%;font-family:'DM Sans',sans-serif;background:#e8f2fa;overflow:hidden;color:var(--text);}

/* APP */
.app{
  max-width:420px;margin:0 auto;height:100vh;
  display:flex;flex-direction:column;
  background:var(--bg);position:relative;
  box-shadow:0 0 80px rgba(2,132,199,0.18);
  overflow:hidden;
}

/* STATUS BAR */
.status-bar{
  background:var(--b4);
  padding:10px 20px 6px;
  display:flex;justify-content:space-between;align-items:center;
  flex-shrink:0;
}
.status-time{color:rgba(255,255,255,0.9);font-size:13px;font-weight:600;}
.status-icons{color:rgba(255,255,255,0.8);font-size:12px;display:flex;gap:6px;}

/* PAGES */
.pages{flex:1;overflow:hidden;position:relative;}
.page{
  position:absolute;inset:0;overflow-y:auto;
  opacity:0;pointer-events:none;
  transform:translateX(20px);
  transition:all 0.35s cubic-bezier(.4,0,.2,1);
  padding-bottom:76px;
  scrollbar-width:thin;scrollbar-color:var(--sky2) transparent;
}
.page::-webkit-scrollbar{width:3px;}
.page::-webkit-scrollbar-thumb{background:var(--sky2);border-radius:4px;}
.page.active{opacity:1;pointer-events:all;transform:translateX(0);}

/* BOTTOM NAV */
.bnav{
  height:72px;background:var(--card);
  border-top:1px solid var(--border);
  display:flex;align-items:center;justify-content:space-around;
  padding:0 4px 4px;flex-shrink:0;
  box-shadow:0 -4px 20px rgba(2,132,199,0.08);
}
.ni{
  display:flex;flex-direction:column;align-items:center;
  gap:4px;cursor:pointer;padding:8px 14px;border-radius:14px;
  transition:all 0.2s;flex:1;
}
.ni:active{transform:scale(0.92);}
.ni.active{background:var(--sky);}
.ni-icon{font-size:21px;filter:grayscale(0.5);transition:all 0.2s;}
.ni-label{font-size:10px;color:var(--muted);font-weight:500;transition:color 0.2s;}
.ni.active .ni-icon{filter:none;}
.ni.active .ni-label{color:var(--b2);font-weight:700;}

/* ── HOME ── */
.home-header{
  background:linear-gradient(160deg, var(--b4) 0%, var(--b2) 60%, var(--b1) 100%);
  padding:20px 20px 80px;position:relative;overflow:hidden;
}
.home-header::before{
  content:'';position:absolute;top:-60px;right:-60px;
  width:220px;height:220px;border-radius:50%;
  background:rgba(255,255,255,0.06);
}
.home-header::after{
  content:'';position:absolute;bottom:-40px;left:-40px;
  width:160px;height:160px;border-radius:50%;
  background:rgba(255,255,255,0.04);
}
.hh-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:22px;}
.hh-logo{
  font-family:'Syne',sans-serif;font-size:1.25rem;font-weight:800;
  color:white;display:flex;align-items:center;gap:8px;
}
.hh-logo-icon{
  width:34px;height:34px;border-radius:10px;
  background:rgba(255,255,255,0.18);
  display:flex;align-items:center;justify-content:center;font-size:18px;
}
.hh-notif{
  width:38px;height:38px;border-radius:12px;
  background:rgba(255,255,255,0.15);
  display:flex;align-items:center;justify-content:center;
  cursor:pointer;font-size:18px;position:relative;
}
.notif-dot{
  position:absolute;top:7px;right:7px;
  width:8px;height:8px;border-radius:50%;
  background:#f43f5e;border:2px solid var(--b3);
}
.hh-greeting{color:rgba(255,255,255,0.75);font-size:13px;margin-bottom:6px;}
.hh-title{
  font-family:'Syne',sans-serif;
  font-size:1.5rem;font-weight:800;color:white;line-height:1.2;
}
.hh-title span{color:var(--sky2);}

/* Hero floating card */
.hero-float{
  margin:-50px 16px 0;
  background:white;border-radius:22px;
  padding:18px 20px;
  box-shadow:0 12px 40px rgba(2,132,199,0.18);
  position:relative;z-index:2;
  border:1px solid rgba(2,132,199,0.08);
}
.hf-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;}
.hf-badge{
  background:var(--mint);color:var(--teal);
  font-size:11px;font-weight:700;padding:4px 10px;border-radius:100px;
  display:flex;align-items:center;gap:4px;
}
.hf-rating{display:flex;align-items:center;gap:4px;font-size:13px;font-weight:700;color:var(--amber);}
.hf-btns{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
.hfb{
  padding:12px;border-radius:14px;border:none;
  font-family:inherit;font-size:13px;font-weight:700;
  cursor:pointer;transition:all 0.2s;
  display:flex;align-items:center;justify-content:center;gap:6px;
}
.hfb:active{transform:scale(0.96);}
.hfb-primary{background:var(--b2);color:white;box-shadow:0 4px 14px rgba(2,132,199,0.35);}
.hfb-primary:hover{background:var(--b3);}
.hfb-secondary{background:var(--sky);color:var(--b2);}
.hfb-secondary:hover{background:var(--sky2);}

/* Stats */
.stats-strip{
  display:grid;grid-template-columns:repeat(3,1fr);
  gap:10px;padding:16px 16px 0;
}
.ss-item{
  background:white;border-radius:16px;padding:14px 10px;
  text-align:center;border:1px solid var(--border);
  transition:all 0.2s;
}
.ss-item:active{transform:scale(0.97);}
.ss-num{font-family:'Syne',sans-serif;font-size:1.35rem;font-weight:800;color:var(--b2);}
.ss-lbl{font-size:11px;color:var(--muted);margin-top:2px;font-weight:500;}

/* Quick menu */
.section{padding:14px 16px 0;}
.sec-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;}
.sec-title{font-family:'Syne',sans-serif;font-size:15px;font-weight:800;}
.sec-more{font-size:12px;color:var(--b2);font-weight:600;cursor:pointer;}
.qmenu{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;}
.qm{
  background:white;border-radius:16px;padding:14px 8px;
  display:flex;flex-direction:column;align-items:center;gap:8px;
  border:1px solid var(--border);cursor:pointer;transition:all 0.2s;
}
.qm:hover{border-color:var(--sky2);background:var(--sky);}
.qm:active{transform:scale(0.94);}
.qm-ico{
  width:46px;height:46px;border-radius:14px;
  display:flex;align-items:center;justify-content:center;font-size:22px;
}
.qm-lbl{font-size:11px;font-weight:600;text-align:center;color:var(--text);line-height:1.3;}

/* Promo */
.promo{
  background:linear-gradient(135deg,var(--teal),#0f766e);
  border-radius:18px;padding:18px;
  display:flex;align-items:center;justify-content:space-between;
  overflow:hidden;position:relative;
}
.promo::after{
  content:'❄️';position:absolute;right:60px;font-size:60px;opacity:0.15;
}
.promo-txt h4{color:white;font-size:14px;font-weight:700;margin-bottom:3px;}
.promo-txt p{color:rgba(255,255,255,0.75);font-size:12px;}
.promo-cta{
  background:white;color:var(--teal);
  border:none;padding:9px 14px;border-radius:10px;
  font-size:12px;font-weight:700;font-family:inherit;
  cursor:pointer;flex-shrink:0;transition:all 0.2s;z-index:1;
}
.promo-cta:active{transform:scale(0.95);}

/* Layanan scroll */
.lscroll{display:flex;gap:12px;overflow-x:auto;padding-bottom:4px;scrollbar-width:none;}
.lscroll::-webkit-scrollbar{display:none;}
.lcard{
  background:white;border-radius:18px;padding:16px;
  min-width:140px;flex-shrink:0;border:1px solid var(--border);
  cursor:pointer;transition:all 0.2s;
}
.lcard:hover{border-color:var(--b1);transform:translateY(-2px);box-shadow:0 6px 20px rgba(2,132,199,0.12);}
.lcard:active{transform:scale(0.97);}
.lcard-ico{font-size:30px;margin-bottom:10px;}
.lcard-name{font-size:13px;font-weight:700;margin-bottom:4px;}
.lcard-price{font-size:12px;font-weight:700;color:var(--b2);}

/* Testi */
.testi-card{
  background:white;border-radius:18px;padding:18px;
  border:1px solid var(--border);
}
.tc-stars{color:var(--amber);font-size:14px;letter-spacing:2px;margin-bottom:10px;}
.tc-text{font-size:13px;color:var(--sub);line-height:1.65;margin-bottom:14px;font-style:italic;}
.tc-author{display:flex;align-items:center;gap:10px;}
.tc-av{
  width:38px;height:38px;border-radius:50%;flex-shrink:0;
  background:linear-gradient(135deg,var(--b2),var(--teal));
  color:white;font-weight:700;font-size:15px;
  display:flex;align-items:center;justify-content:center;
}
.tc-name{font-size:13px;font-weight:700;}
.tc-loc{font-size:11px;color:var(--muted);}

/* ── LAYANAN PAGE ── */
.ph{
  background:linear-gradient(160deg,var(--b4),var(--b2));
  padding:20px 20px 24px;
}
.ph h1{font-family:'Syne',sans-serif;font-size:1.4rem;font-weight:800;color:white;margin-bottom:4px;}
.ph p{color:rgba(255,255,255,0.7);font-size:13px;}

/* Search bar */
.search-bar{
  margin:14px 16px 0;position:relative;
}
.search-bar input{
  width:100%;padding:13px 16px 13px 44px;
  border:1.5px solid var(--border);border-radius:14px;
  font-family:inherit;font-size:14px;background:white;
  outline:none;transition:border-color 0.2s;color:var(--text);
}
.search-bar input:focus{border-color:var(--b1);}
.search-ico{position:absolute;left:14px;top:50%;transform:translateY(-50%);font-size:18px;}

/* Layanan list */
.llist{padding:14px 16px;display:flex;flex-direction:column;gap:12px;}
.llcard{
  background:white;border-radius:18px;padding:16px;
  border:1.5px solid var(--border);display:flex;gap:14px;
  transition:all 0.2s;cursor:pointer;position:relative;overflow:hidden;
}
.llcard::before{
  content:'';position:absolute;left:0;top:0;bottom:0;width:3px;
  background:linear-gradient(var(--b1),var(--teal));
  transform:scaleY(0);transition:transform 0.2s;transform-origin:bottom;
}
.llcard:hover::before{transform:scaleY(1);}
.llcard:hover{border-color:var(--sky2);box-shadow:0 4px 20px rgba(2,132,199,0.10);}
.llcard:active{transform:scale(0.98);}
.ll-ico{
  width:54px;height:54px;border-radius:16px;background:var(--sky);
  display:flex;align-items:center;justify-content:center;font-size:26px;flex-shrink:0;
}
.ll-info{flex:1;}
.ll-name{font-family:'Syne',sans-serif;font-size:15px;font-weight:800;margin-bottom:4px;}
.ll-desc{font-size:12px;color:var(--muted);line-height:1.5;margin-bottom:10px;}
.ll-bottom{display:flex;align-items:center;justify-content:space-between;}
.ll-price{font-size:15px;font-weight:700;color:var(--b2);}
.ll-price span{font-size:11px;font-weight:400;color:var(--muted);}
.ll-btn{
  background:var(--b2);color:white;border:none;
  padding:8px 14px;border-radius:10px;font-size:12px;
  font-weight:700;font-family:inherit;cursor:pointer;transition:all 0.2s;
}
.ll-btn:hover{background:var(--b3);}
.ll-btn:active{transform:scale(0.95);}
.badge-hot{
  position:absolute;top:12px;right:12px;
  background:linear-gradient(135deg,var(--rose),#e11d48);
  color:white;font-size:10px;font-weight:700;
  padding:3px 9px;border-radius:100px;
}

/* ── FORM PAGE ── */
.fscroll{padding:14px 16px;}
.fcard{
  background:white;border-radius:20px;padding:18px;
  border:1px solid var(--border);margin-bottom:12px;
}
.fcard-title{
  font-family:'Syne',sans-serif;font-size:14px;font-weight:800;
  margin-bottom:16px;display:flex;align-items:center;gap:8px;color:var(--text);
}
.fcard-title span{
  width:28px;height:28px;border-radius:8px;background:var(--sky);
  display:flex;align-items:center;justify-content:center;font-size:14px;
}
.fg{margin-bottom:13px;}
.fg:last-child{margin-bottom:0;}
.fg label{font-size:11px;font-weight:700;color:var(--muted);letter-spacing:0.5px;text-transform:uppercase;display:block;margin-bottom:6px;}
.fg input,.fg select,.fg textarea{
  width:100%;padding:12px 14px;
  border:1.5px solid var(--border);border-radius:12px;
  font-family:inherit;font-size:14px;color:var(--text);
  background:var(--bg);outline:none;transition:all 0.2s;
}
.fg input:focus,.fg select:focus,.fg textarea:focus{
  border-color:var(--b1);background:white;
  box-shadow:0 0 0 3px rgba(14,165,233,0.08);
}
.fg textarea{resize:none;height:78px;}
.frow{display:grid;grid-template-columns:1fr 1fr;gap:10px;}

.submit-btn{
  width:100%;padding:16px;
  background:linear-gradient(135deg,var(--b2),var(--b1));
  color:white;border:none;border-radius:16px;
  font-family:'Syne',sans-serif;font-size:16px;font-weight:800;
  cursor:pointer;transition:all 0.2s;
  box-shadow:0 6px 20px rgba(2,132,199,0.35);
  display:flex;align-items:center;justify-content:center;gap:8px;
}
.submit-btn:hover{box-shadow:0 8px 28px rgba(2,132,199,0.45);transform:translateY(-1px);}
.submit-btn:active{transform:scale(0.98);}

.notif-ok{
  display:none;margin-top:12px;
  background:linear-gradient(135deg,#dcfce7,#bbf7d0);
  border:1.5px solid #86efac;border-radius:16px;
  padding:18px;text-align:center;
}
.notif-ok .nok-icon{font-size:32px;margin-bottom:8px;}
.notif-ok h4{font-family:'Syne',sans-serif;font-size:15px;font-weight:800;color:#15803d;margin-bottom:4px;}
.notif-ok p{font-size:13px;color:#16a34a;line-height:1.5;}

/* ── SOSMED PAGE ── */
.sm-header{
  background:linear-gradient(160deg,var(--b4),var(--b2));
  padding:20px 20px 30px;text-align:center;
}
.sm-av{
  width:76px;height:76px;border-radius:50%;
  background:rgba(255,255,255,0.18);margin:0 auto 12px;
  display:flex;align-items:center;justify-content:center;font-size:34px;
  border:3px solid rgba(255,255,255,0.3);
}
.sm-header h2{font-family:'Syne',sans-serif;font-size:1.2rem;font-weight:800;color:white;}
.sm-header p{color:rgba(255,255,255,0.7);font-size:13px;margin-top:6px;line-height:1.5;}
.sm-verified{
  display:inline-flex;align-items:center;gap:4px;
  background:rgba(255,255,255,0.15);color:white;
  font-size:11px;font-weight:600;padding:4px 10px;border-radius:100px;margin-top:10px;
}

.sm-list{padding:14px 16px;display:flex;flex-direction:column;gap:10px;}
.sm-item{
  background:white;border-radius:16px;padding:15px 16px;
  border:1px solid var(--border);display:flex;align-items:center;
  gap:14px;cursor:pointer;transition:all 0.2s;text-decoration:none;
}
.sm-item:hover{transform:translateX(4px);box-shadow:0 4px 16px rgba(0,0,0,0.06);border-color:var(--sky2);}
.sm-item:active{transform:scale(0.98);}
.sm-ico{
  width:46px;height:46px;border-radius:14px;
  display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0;
}
.sm-info{flex:1;}
.sm-name{font-size:14px;font-weight:700;color:var(--text);}
.sm-handle{font-size:12px;color:var(--muted);margin-top:2px;}
.sm-arr{color:var(--muted);font-size:18px;font-weight:300;}

/* ── TENTANG PAGE ── */
.ta-header{
  background:linear-gradient(160deg,var(--b4),var(--b2));
  padding:20px 20px 28px;text-align:center;
}
.ta-logo{font-size:52px;margin-bottom:12px;}
.ta-header h2{font-family:'Syne',sans-serif;font-size:1.3rem;font-weight:800;color:white;}
.ta-header p{color:rgba(255,255,255,0.7);font-size:13px;margin-top:6px;line-height:1.5;}

.ta-body{padding:14px 16px;}
.ta-card{
  background:white;border-radius:20px;padding:18px;
  border:1px solid var(--border);margin-bottom:12px;
}
.ta-card-title{
  font-family:'Syne',sans-serif;font-size:14px;font-weight:800;
  color:var(--b2);margin-bottom:14px;display:flex;align-items:center;gap:6px;
}
.ta-row{
  display:flex;align-items:flex-start;gap:12px;
  padding:11px 0;border-bottom:1px solid var(--border);
}
.ta-row:last-child{border-bottom:none;padding-bottom:0;}
.ta-ico{font-size:20px;flex-shrink:0;margin-top:1px;}
.ta-lbl{font-size:11px;color:var(--muted);font-weight:600;text-transform:uppercase;letter-spacing:0.5px;}
.ta-val{font-size:14px;font-weight:600;color:var(--text);margin-top:2px;}

.nilai-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;}
.nv{
  background:var(--sky);border-radius:14px;padding:14px 8px;
  text-align:center;border:1px solid var(--sky2);transition:all 0.2s;
}
.nv:active{transform:scale(0.97);}
.nv-ico{font-size:24px;margin-bottom:6px;}
.nv-txt{font-size:11px;font-weight:700;color:var(--b3);line-height:1.3;}

.ach-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;}
.ach{
  background:linear-gradient(135deg,var(--sky),white);
  border-radius:14px;padding:14px 8px;text-align:center;
  border:1px solid var(--sky2);
}
.ach-num{font-family:'Syne',sans-serif;font-size:1.3rem;font-weight:800;color:var(--b2);}
.ach-lbl{font-size:11px;color:var(--sub);margin-top:2px;font-weight:500;}

/* Animations */
@keyframes fadeUp{from{opacity:0;transform:translateY(16px);}to{opacity:1;transform:translateY(0);}}
.page.active .hero-float{animation:fadeUp 0.4s ease 0.1s both;}
.page.active .stats-strip{animation:fadeUp 0.4s ease 0.2s both;}
</style>
</head>
<body>
<div class="app">

  <!-- Status Bar -->
  <div class="status-bar">
    <div class="status-time" id="clock">09:41</div>
    <div class="status-icons">
      <span>📶</span><span>🔋</span>
    </div>
  </div>

  <div class="pages">

    <!-- ════════ HOME ════════ -->
    <div class="page active" id="page-home">
      <div class="home-header">
        <div class="hh-top">
          <div class="hh-logo">
            <div class="hh-logo-icon">❄️</div>
            ArcticCool
          </div>
          <div class="hh-notif">🔔<div class="notif-dot"></div></div>
        </div>
        <div class="hh-greeting">Selamat datang!</div>
        <div class="hh-title">AC Bersih &<br><span>Dingin Kembali</span> ❄️</div>
      </div>

      <div class="hero-float">
        <div class="hf-top">
          <div class="hf-badge">✅ Garansi 30 Hari</div>
          <div class="hf-rating">★ 5.0 <span style="color:var(--muted);font-weight:400;font-size:11px;">(500+ ulasan)</span></div>
        </div>
        <div class="hf-btns">
          <button class="hfb hfb-primary" onclick="goPage('pesan')">📋 Pesan Sekarang</button>
          <button class="hfb hfb-secondary" onclick="goPage('layanan')">🧹 Lihat Layanan</button>
        </div>
      </div>

      <div class="stats-strip">
        <div class="ss-item">
          <div class="ss-num">500+</div>
          <div class="ss-lbl">Pelanggan</div>
        </div>
        <div class="ss-item">
          <div class="ss-num">5★</div>
          <div class="ss-lbl">Rating</div>
        </div>
        <div class="ss-item">
          <div class="ss-num">3 Thn</div>
          <div class="ss-lbl">Pengalaman</div>
        </div>
      </div>

      <div class="section">
        <div class="sec-head">
          <div class="sec-title">Menu Cepat</div>
        </div>
        <div class="qmenu">
          <div class="qm" onclick="goPage('layanan')">
            <div class="qm-ico" style="background:#e0f2fe;">🧹</div>
            <div class="qm-lbl">Cuci AC</div>
          </div>
          <div class="qm" onclick="goPage('layanan')">
            <div class="qm-ico" style="background:#ccfbf1;">❄️</div>
