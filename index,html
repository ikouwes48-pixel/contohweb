<script>
// Clock
function updateClock(){
  const now=new Date();
  const h=String(now.getHours()).padStart(2,'0');
  const m=String(now.getMinutes()).padStart(2,'0');
  document.getElementById('clock').textContent=h+':'+m;
}
updateClock();setInterval(updateClock,1000);

// Navigation
function goPage(name){
  document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
  document.querySelectorAll('.ni').forEach(n=>n.classList.remove('active'));
  document.getElementById('page-'+name).classList.add('active');
  document.getElementById('nav-'+name).classList.add('active');
  document.getElementById('page-'+name).scrollTop=0;
}

// Select layanan from card
function pesanLayanan(val){
  goPage('pesan');
  setTimeout(()=>{
    const s=document.getElementById('f-layanan');
    for(let o of s.options){if(o.value===val||o.text===val){s.value=o.value;break;}}
  },150);
}

// Filter layanan
function filterLayanan(q){
  const cards=document.querySelectorAll('#layanan-list .llcard');
  cards.forEach(c=>{
    const name=c.dataset.name||'';
    c.style.display=name.includes(q.toLowerCase())||q===''?'flex':'none';
  });
}

// Submit form
function kirimPesanan(){
  const nama=document.getElementById('f-nama').value.trim();
  const hp=document.getElementById('f-hp').value.trim();
  const alamat=document.getElementById('f-alamat').value.trim();
  const layanan=document.getElementById('f-layanan').value;
  if(!nama||!hp||!alamat||!layanan){
    alert('⚠️ Mohon isi semua kolom yang wajib!');return;
  }
  const btn=document.getElementById('submit-btn');
  btn.innerHTML='⏳ Mengirim pesanan...';
  btn.disabled=true;
  btn.style.background='linear-gradient(135deg,#94a3b8,#94a3b8)';
  btn.style.boxShadow='none';
  setTimeout(()=>{
    document.getElementById('notif-ok').style.display='block';
    btn.innerHTML='✅ Pesanan Terkirim!';
    btn.style.background='linear-gradient(135deg,#10b981,#059669)';
    btn.style.boxShadow='0 6px 20px rgba(16,185,129,0.35)';
    document.getElementById('notif-ok').scrollIntoView({behavior:'smooth',block:'center'});
    ['f-nama','f-hp','f-alamat','f-catatan'].forEach(id=>document.getElementById(id).value='');
    document.getElementById('f-layanan').value='';
  },1800);
}
</script>
